# App Store Connect API key: copy to fastlane/.env (gitignored) and fill in. Never commit the key.
# Create at App Store Connect → Users and Access → Integrations → App Store Connect API → Team Keys.
# Role: Admin (cloud signing of the export needs it; App Manager gets "Cloud signing permission error").
# Apple lets you download the .p8 once. A key of the same team works for every app of it.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
# Absolute path, or relative to ios/ (where fastlane runs).
ASC_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
